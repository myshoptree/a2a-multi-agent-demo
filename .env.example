# OpenRouter API Key (obligatoria)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Modelo a usar - cualquier modelo de OpenRouter
# Opciones baratas: openai/gpt-4o-mini, anthropic/claude-3-haiku, mistralai/mistral-7b-instruct
MODEL_NAME=openai/gpt-4o-mini

# Puerto único del servidor
SERVER_PORT=9000
SERVER_HOST=0.0.0.0
